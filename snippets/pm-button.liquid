{%- comment -%}
  Animated pill button.
  Accepts:
  - label: {String} Button text
  - link: {String} Button URL (renders a disabled link when blank)
  - style: {String} 'dark'/'brand' (theme, default), 'light', 'ink' or 'outline'
  - class: {String} Extra class names
{%- endcomment -%}
{{ 'component-pm-button.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign pm_class = 'pm pm-a pm--brand'
  case style
    when 'light'
      assign pm_class = 'pm pm-a pm--light'
    when 'ink'
      assign pm_class = 'pm pm-a pm--ink'
    when 'dark'
      assign pm_class = 'pm pm-a pm--brand'
    when 'brand'
      assign pm_class = 'pm pm-a pm--brand'
    when 'outline'
      assign pm_class = 'pm pm-s'
  endcase
-%}
<a
  {% if link != blank %}
    href="{{ link }}"
  {% else %}
    role="link" aria-disabled="true"
  {% endif %}
  class="{{ pm_class }}{% if class != blank %} {{ class }}{% endif %}"
>
  {%- if style == 'outline' -%}
    <span class="pm-z">{{ label | escape }}</span>
  {%- else -%}
    <span class="pm-roll">
      <span>{{ label | escape }}</span>
      <span aria-hidden="true">{{ label | escape }}</span>
    </span>
    <span class="pm-dot" aria-hidden="true">
      <span class="pm-bg"></span>
      <span class="pm-clip">
        {%- for i in (1..2) -%}
          <span class="pm-ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"/></svg>
          </span>
        {%- endfor -%}
      </span>
    </span>
  {%- endif -%}
</a>
