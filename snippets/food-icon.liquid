{%- comment -%}
  Line icons for the food (burger) page sections.
  Accepts:
  - icon: {String} Icon name
  - class: {String} Optional extra class
{%- endcomment -%}
<svg
  class="food-icon{% if class != blank %} {{ class }}{% endif %}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'burger' -%}
      <path d="M4 10.5C4 6.9 7.6 4.5 12 4.5s8 2.4 8 6H4Z"/><path d="M3.5 13.5h17"/><path d="M4.5 16.5h15a2.5 2.5 0 0 1-2.5 2.5H7a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M9 7.5h.01M12 6.8h.01M15 7.5h.01"/>
    {%- when 'beef' -%}
      <path d="M5 8.5c0-2 1.8-3.5 4-3.5h5.5c3 0 5.5 2.4 5.5 5.3 0 3.4-2.9 5.7-6.4 5.7H11l-3.5 3.5-.8-3.8C5.6 14.8 5 13.4 5 12Z"/><circle cx="14" cy="10.5" r="1.8"/>
    {%- when 'chicken' -%}
      <path d="M14.5 4.5a5 5 0 0 1 2.7 9.2c-1 .7-2.2 1-3.4 1l-3.5 3.5"/><path d="M14.5 4.5a5 5 0 0 0-5 5c0 1.2.3 2.3 1 3.3L7 16.3"/><path d="M7 16.3a1.8 1.8 0 1 0-1.6 3.1 1.8 1.8 0 1 0 3.1-1.6"/>
    {%- when 'spicy' -%}
      <path d="M13 6c1.5-.2 3 .6 3.5 2 1.4 3.9-2.4 11-10.5 11.5C9 17 10 13.5 10.5 10c.3-2.1 1-3.8 2.5-4Z"/><path d="M13 6c0-1.5.8-2.5 2-3"/>
    {%- when 'veggie' -%}
      <path d="M5 19c0-8 5-13 14-14-.5 9-5.5 14-14 14Z"/><path d="M5 19 13 11"/>
    {%- when 'signature' -%}
      <path d="m12 3.8 2.5 5.1 5.6.8-4 3.9 1 5.6L12 16.6l-5.1 2.6 1-5.6-4-3.9 5.6-.8Z"/>
    {%- when 'fish' -%}
      <path d="M3.5 12c3-4.5 9-6 13-2l3.5-2.5v9L16.5 14c-4 4-10 2.5-13-2Z"/><path d="M8 11.5h.01"/>
    {%- when 'fries' -%}
      <path d="M6 10h12l-1.5 10h-9Z"/><path d="M8 10 7.5 4M11 10V3.5M13.5 10l.5-6M16 10l1-5"/>
    {%- when 'truck' -%}
      <path d="M3 6.5h11v9H3Z"/><path d="M14 9.5h3.5l3 3v3H14"/><circle cx="7" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
    {%- when 'fresh' -%}
      <path d="M12 3.5c3.5 3 5.5 6 5.5 9a5.5 5.5 0 0 1-11 0c0-3 2-6 5.5-9Z"/><path d="m9.5 13 2 2 3.5-4"/>
    {%- when 'secure' -%}
      <rect x="3.5" y="6" width="17" height="12" rx="2"/><path d="M3.5 10h17M7 14.5h3"/>
    {%- when 'leaf-check' -%}
      <path d="M12 3.5 19 6v5.5c0 4.2-3 7.5-7 9-4-1.5-7-4.8-7-9V6Z"/><path d="m9 12 2 2 4-4.5"/>
    {%- when 'protein' -%}
      <path d="M6.5 8v8M17.5 8v8M4 10v4M20 10v4M6.5 12h11"/>
    {%- when 'natural' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="m6 6 12 12"/>
    {%- when 'box' -%}
      <path d="M3.5 8 12 4l8.5 4v8L12 20l-8.5-4Z"/><path d="M3.5 8 12 12l8.5-4M12 12v8"/>
    {%- when 'cube' -%}
      <path d="M12 3.5 19.5 8v8L12 20.5 4.5 16V8Z"/><path d="M4.5 8 12 12.5 19.5 8M12 12.5v8"/>
    {%- when 'play' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="m10 8.8 5 3.2-5 3.2Z"/>
    {%- when 'rotate' -%}
      <path d="M20 12a8 8 0 1 1-2.4-5.7"/><path d="M20 4v4.5h-4.5"/>
    {%- when 'heart' -%}
      <path d="M12 19.5s-7.5-4.4-7.5-9.7A4.3 4.3 0 0 1 12 7.2a4.3 4.3 0 0 1 7.5 2.6c0 5.3-7.5 9.7-7.5 9.7Z"/>
    {%- when 'plus' -%}
      <path d="M12 5.5v13M5.5 12h13"/>
    {%- when 'minus' -%}
      <path d="M5.5 12h13"/>
    {%- when 'cart' -%}
      <path d="M3.5 4.5h2l2 10.5h10l2-7.5H6.6"/><circle cx="9" cy="19" r="1.3"/><circle cx="16.5" cy="19" r="1.3"/>
    {%- when 'arrow' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9.5 6 6 6-6"/>
    {%- when 'chevron-up' -%}
      <path d="m6 14.5 6-6 6 6"/>
    {%- when 'sync' -%}
      <path d="M19.5 12a7.5 7.5 0 0 1-13 5.1"/><path d="M4.5 12a7.5 7.5 0 0 1 13-5.1"/><path d="M17.5 3.5v3.4h-3.4M6.5 20.5v-3.4h3.4"/>
    {%- when 'badge' -%}
      <circle cx="12" cy="10" r="6"/><path d="m8.5 15-1.5 5.5 5-2.5 5 2.5-1.5-5.5"/>
    {%- else -%}
      <path d="M4 10.5C4 6.9 7.6 4.5 12 4.5s8 2.4 8 6H4Z"/><path d="M3.5 13.5h17"/><path d="M4.5 16.5h15a2.5 2.5 0 0 1-2.5 2.5H7a2.5 2.5 0 0 1-2.5-2.5Z"/>
  {%- endcase -%}
</svg>
