{%- render 'food-assets', section: section -%}

<section
  class="food food-features{% if section.settings.light_mode %} food--light{% endif %}"
  data-food="features"
  style="--food-bg: {{ section.settings.bg }}; --food-card: {{ section.settings.card }}; --food-accent: {{ section.settings.accent }}; --food-text: {{ section.settings.text_color }};"
>
  <div class="page-width section-{{ section.id }}-padding">
    <ul class="food-features__list" role="list">
      {%- for block in section.blocks -%}
        <li class="food-features__item" {{ block.shopify_attributes }}>
          <span class="food-features__icon">{%- render 'food-icon', icon: block.settings.icon -%}</span>
          <span class="food-features__text">
            <strong>{{ block.settings.title | escape }}</strong>
            {%- if block.settings.text != blank -%}
              <span>{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Food features",
  "tag": "section",
  "class": "section food-section",
  "settings": [
    { "type": "checkbox", "id": "light_mode", "label": "Light version", "info": "Use with a light background and dark text color.", "default": false },
    { "type": "color", "id": "bg", "label": "Background", "default": "#0a0a0a" },
    { "type": "color", "id": "card", "label": "Card background", "default": "#141414" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#f5a623" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 8 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 6,
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "truck",
          "options": [
            { "value": "truck", "label": "Truck" }, { "value": "clock", "label": "Clock" },
            { "value": "fresh", "label": "Fresh drop" }, { "value": "secure", "label": "Card" },
            { "value": "leaf-check", "label": "Shield check" }, { "value": "box", "label": "Box" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Free Delivery" },
        { "type": "text", "id": "text", "label": "Text", "default": "On orders over $50" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Food features",
      "blocks": [
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
