{% render 'cm-section-assets', section: section %}

{%- liquid
  assign chips = section.blocks | where: 'type', 'chip'
-%}

<div class="cm cm-hero" data-cm="hero">
  <div class="cm-hero__glow" aria-hidden="true"></div>
  <div class="page-width section-{{ section.id }}-padding">
    <div class="cm-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="cm-hero__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cm-hero__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="cm-hero__sub">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
  </div>

  {%- if chips.size > 0 -%}
    <div class="cm-ticker" style="--cm-ticker-speed: {{ section.settings.ticker_speed }}s;">
      <div class="cm-ticker__track">
        {%- for pass in (1..2) -%}
          {%- for block in chips -%}
            <div
              class="cm-chip"
              {% if pass == 1 %}
                {{ block.shopify_attributes }}
              {% else %}
                aria-hidden="true"
              {% endif %}
            >
              <span class="cm-chip__num">{{ block.settings.number | escape }}</span>
              <span class="cm-chip__label">{{ block.settings.label | escape }}</span>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "CM hero + ticker",
  "tag": "section",
  "class": "section cm-section",
  "blocks": [
    {
      "type": "chip",
      "name": "Ticker stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "40+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Years Experience"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Hartland's #1 Meal Prep Chef"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Each new line becomes a line break.",
      "default": "Calorie Counted Meals.\nHigh Protein. Low Oil.\nDelivered Across Hartland."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "ticker_speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Ticker loop duration",
      "default": 30
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 44
    }
  ],
  "presets": [
    {
      "name": "CM hero + ticker",
      "blocks": [
        { "type": "chip", "settings": { "number": "40+", "label": "Years Experience" } },
        { "type": "chip", "settings": { "number": "<600", "label": "Cal Most Meals" } },
        { "type": "chip", "settings": { "number": "45g", "label": "Protein Most Meals" } },
        { "type": "chip", "settings": { "number": "24oz", "label": "Per Container" } },
        { "type": "chip", "settings": { "number": "2-3 Min", "label": "Heat and Eat" } },
        { "type": "chip", "settings": { "number": "Fresh", "label": "Never Frozen" } },
        { "type": "chip", "settings": { "number": "Gluten", "label": "Free Options" } }
      ]
    }
  ]
}
{% endschema %}
