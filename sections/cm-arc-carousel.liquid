{% render 'cm-section-assets', section: section %}
<script src="{{ 'cm-arc-carousel.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign source = 'blocks'
  if section.blocks.size == 0 and section.settings.collection != blank
    assign source = 'collection'
  endif

  assign item_count = 0
  if source == 'collection'
    for product in section.settings.collection.products limit: section.settings.products_limit
      if product.featured_image != blank
        assign item_count = item_count | plus: 1
      endif
    endfor
  else
    for block in section.blocks
      if block.settings.image != blank or block.settings.image_asset != blank or request.design_mode
        assign item_count = item_count | plus: 1
      endif
    endfor
  endif
-%}
{%- if item_count > 0 -%}

<div
  class="cm cm-arc cm-arc--{{ section.settings.image_style }}"
  data-cm="arc"
  style="
    --cm-arc-bg-1: {{ section.settings.bg_color_1 }};
    --cm-arc-bg-2: {{ section.settings.bg_color_2 }};
    --cm-arc-text: {{ section.settings.text_color }};
    --cm-arc-accent: {{ section.settings.accent }};
    --cm-arc-w-max: {{ section.settings.item_width }}px;
    --cm-arc-ratio: {{ section.settings.item_shape }};
    --cm-arc-curve: {{ section.settings.curve | abs }}px;
  "
>
  <div class="cm-arc__spot" aria-hidden="true"></div>
  <div class="cm-arc__glow" aria-hidden="true"></div>
  {%- if section.settings.show_frame -%}
    <div class="cm-arc__frame" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  {%- endif -%}
  <div class="cm-arc__content section-{{ section.id }}-padding">
    {%- if section.settings.label != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="cm-center page-width">
        {%- if section.settings.label != blank -%}
          <span class="cm-label">{{ section.settings.label | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="cm-heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="cm-body">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <cm-arc-carousel
      class="{% if section.settings.full_width %}cm-arc--full{% else %}page-width{% endif %}"
      data-gap="{{ section.settings.gap }}"
      data-curve="{{ section.settings.curve }}"
      data-tilt="{{ section.settings.tilt }}"
      data-autoplay="{% if section.settings.autoplay %}{{ section.settings.autoplay_speed }}{% else %}0{% endif %}"
      data-accent="{{ section.settings.accent }}"
    >
      <div class="cm-arc__stage-wrap">
        <div
          class="cm-arc__stage"
          tabindex="0"
          role="region"
          aria-roledescription="carousel"
          aria-label="{{ section.settings.heading | default: 'Products' | escape }}"
        >
          {%- if source == 'collection' -%}
            {%- for product in section.settings.collection.products limit: section.settings.products_limit -%}
              {%- if product.featured_image == blank -%}{%- continue -%}{%- endif -%}
              {%- assign product_price = product.price | money -%}
              {%- render 'cm-arc-item',
                image: product.featured_image,
                title: product.title,
                subtitle: product_price,
                link: product.url,
                accent: section.settings.accent,
                index: forloop.index0
              -%}
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.image == blank and block.settings.image_asset == blank -%}
                {%- unless request.design_mode -%}{%- continue -%}{%- endunless -%}
              {%- endif -%}
              {%- render 'cm-arc-item',
                image: block.settings.image,
                image_asset: block.settings.image_asset,
                title: block.settings.title,
                subtitle: block.settings.subtitle,
                link: block.settings.link,
                accent: block.settings.accent,
                index: forloop.index0,
                attrs: block.shopify_attributes
              -%}
            {%- endfor -%}
          {%- endif -%}
        </div>

        {%- if section.settings.show_arrows -%}
          <button type="button" class="cm-arc__nav cm-arc__nav--prev" data-arc-prev aria-label="Previous">
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 6l-6 6 6 6M19 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="cm-arc__nav cm-arc__nav--next" data-arc-next aria-label="Next">
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 6l6 6-6 6M5 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        {%- endif -%}
      </div>

      <div class="cm-arc__info page-width" aria-live="polite">
        <h3 class="cm-arc__title"></h3>
        <p class="cm-arc__subtitle"></p>
        <div class="cm-arc__progress" aria-hidden="true">
          <span class="cm-arc__progress-fill"></span>
          <span class="cm-arc__progress-dot"></span>
        </div>
        {%- if section.settings.button_label != blank -%}
          <a class="cm-btn cm-arc__btn" href="#" hidden>
            <span>{{ section.settings.button_label | escape }}</span>
            <span class="cm-arc__btn-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        {%- endif -%}
        {%- if section.settings.hint != blank -%}
          <p class="cm-arc__hint">{{ section.settings.hint | escape }}</p>
        {%- endif -%}
      </div>
    </cm-arc-carousel>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "CM 3D product carousel",
  "tag": "section",
  "class": "section cm-section",
  "max_blocks": 20,
  "blocks": [
    {
      "type": "item",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Use a transparent PNG cut-out for the best 3D look."
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Theme asset image",
          "info": "Filename in the theme assets folder, used when no image is picked."
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Chicken Teriyaki" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "High protein" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "color", "id": "accent", "label": "Glow color", "default": "#3a66b0" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "This Week's Menu" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Pick Your Flavor" },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Used only when the section has no product blocks."
    },
    { "type": "range", "id": "products_limit", "min": 3, "max": 20, "step": 1, "label": "Products to show", "default": 9 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "select",
      "id": "item_shape",
      "label": "Product shape",
      "options": [
        { "value": "2", "label": "Tall (cans, bottles)" },
        { "value": "1.5", "label": "Portrait" },
        { "value": "1.2", "label": "Box" },
        { "value": "1", "label": "Square (plates, bowls)" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_style",
      "label": "Image style",
      "options": [
        { "value": "cutout", "label": "Cut-out (transparent PNG)" },
        { "value": "card", "label": "Photo card" }
      ],
      "default": "cutout"
    },
    { "type": "checkbox", "id": "full_width", "label": "Full page width", "default": true },
    { "type": "range", "id": "item_width", "min": 100, "max": 280, "step": 10, "unit": "px", "label": "Product width", "default": 170 },
    { "type": "range", "id": "gap", "min": 0, "max": 160, "step": 5, "unit": "px", "label": "Gap between products", "default": 60 },
    { "type": "range", "id": "curve", "min": -100, "max": 150, "step": 5, "unit": "px", "label": "Wave height", "default": 50 },
    { "type": "range", "id": "tilt", "min": 0, "max": 30, "step": 1, "unit": "°", "label": "Product tilt", "default": 12 },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate", "default": true },
    { "type": "range", "id": "autoplay_speed", "min": 2, "max": 10, "step": 1, "unit": "s", "label": "Change every", "default": 4 },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows", "default": true },
    { "type": "checkbox", "id": "show_frame", "label": "Show corner frame", "default": true },
    { "type": "text", "id": "hint", "label": "Hint text", "default": "Drag to explore" },
    {
      "type": "header",
      "content": "Colors"
    },
    { "type": "color", "id": "bg_color_1", "label": "Background center", "default": "#3a3a3a" },
    { "type": "color", "id": "bg_color_2", "label": "Background edge", "default": "#070707" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "accent", "label": "Default glow and button", "default": "#3a66b0" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "presets": [
    {
      "name": "CM 3D product carousel",
      "blocks": [
        { "type": "item", "settings": { "title": "Chicken Teriyaki", "subtitle": "45g protein", "accent": "#c0392b" } },
        { "type": "item", "settings": { "title": "Shrimp Pasta", "subtitle": "Chef favorite", "accent": "#e67e22" } },
        { "type": "item", "settings": { "title": "Red Thai Curry", "subtitle": "Spicy and bold", "accent": "#d35400" } },
        { "type": "item", "settings": { "title": "Lamb Ragout", "subtitle": "Slow cooked", "accent": "#8e44ad" } },
        { "type": "item", "settings": { "title": "BBQ Chicken", "subtitle": "24oz portion", "accent": "#16a085" } },
        { "type": "item", "settings": { "title": "Salmon & Rice", "subtitle": "Omega-3 rich", "accent": "#2980b9" } },
        { "type": "item", "settings": { "title": "Steak Fajita", "subtitle": "Low oil", "accent": "#27ae60" } }
      ]
    }
  ]
}
{% endschema %}
