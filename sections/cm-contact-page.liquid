<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Gloock&display=swap"
>
{{ 'section-cm-contact-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign form_id = 'CmContactPage-' | append: section.id
  assign phone_display = section.settings.phone
  assign phone_digits = phone_display | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.'
  assign contact_items = section.blocks | where: 'type', 'contact_item'
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .cmc {
    --cmc-amber: {{ section.settings.accent }};
    --cmc-navy: {{ section.settings.navy }};
    padding-top: calc({{ section.settings.padding_top | times: 0.75 | round: 0 }}px + clamp(5.5rem, 11vw, 8.5rem));
    padding-bottom: calc({{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px + clamp(3.5rem, 7vw, 5.5rem));
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .cmc {
      padding-top: calc({{ section.settings.padding_top }}px + clamp(5.5rem, 11vw, 8.5rem));
      padding-bottom: calc({{ section.settings.padding_bottom }}px + clamp(3.5rem, 7vw, 5.5rem));
    }
  }
{%- endstyle -%}

<section
  class="cmc"
  data-cm="contact-page"
  aria-labelledby="{{ form_id }}-title"
>
  <div class="cmc__wrap">
    <header class="cmc__head">
      <div class="cmc__head-text">
        {%- if section.settings.heading != blank -%}
          <h1 class="cmc__title" id="{{ form_id }}-title">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="cmc__lead">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.show_stamp and section.settings.stamp_number != blank -%}
        <div class="cmc__stamp" aria-hidden="true">
          <span class="cmc__stamp-inner">
            <b>{{ section.settings.stamp_number | escape }}</b>
            {{- section.settings.stamp_label | escape | newline_to_br -}}
          </span>
        </div>
      {%- endif -%}
    </header>

    <div class="cmc__grid">
      <aside class="cmc__panel">
        {%- if section.settings.panel_heading != blank -%}
          <h3 class="cmc__panel-title">{{ section.settings.panel_heading | escape }}</h3>
        {%- endif -%}

        {%- if contact_items.size > 0 -%}
          <ul class="cmc__list">
            {%- for block in contact_items -%}
              {%- liquid
                assign item_link = block.settings.link
                assign item_value = block.settings.value
                if block.settings.icon == 'phone' and item_link == blank and item_value != blank
                  assign item_tel = item_value | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.'
                  assign item_link = 'tel:' | append: item_tel
                endif
              -%}
              <li class="cmc__item" {{ block.shopify_attributes }}>
                <div class="cmc__ico" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'pin' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    {%- when 'clock' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    {%- when 'mail' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
                  {%- endcase -%}
                </div>
                <div class="cmc__item-copy">
                  {%- if block.settings.label != blank -%}
                    <b>{{ block.settings.label | escape }}</b>
                  {%- endif -%}
                  {%- if item_link != blank -%}
                    <a href="{{ item_link }}">{{ item_value | escape }}</a>
                  {%- else -%}
                    <span>{{ item_value | escape }}</span>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.panel_note != blank or settings.social_facebook_link != blank or settings.social_instagram_link != blank -%}
          <div class="cmc__more">
            {%- if section.settings.panel_note != blank -%}
              <p>{{ section.settings.panel_note | escape }}</p>
            {%- endif -%}
            {%- if section.settings.show_social -%}
              <div class="cmc__social">
                {%- if settings.social_facebook_link != blank -%}
                  <a href="{{ settings.social_facebook_link }}" aria-label="Facebook" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8h2.7l.5-3.2h-3.2V8.7c0-.9.4-1.7 1.8-1.7h1.5V4.2S15.5 4 14.3 4C11.8 4 10.2 5.5 10.2 8.2v2.6H7.5V14h2.7v8z"/></svg>
                  </a>
                {%- endif -%}
                {%- if settings.social_instagram_link != blank -%}
                  <a href="{{ settings.social_instagram_link }}" aria-label="Instagram" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.call_label != blank and phone_display != blank -%}
          <a class="cmc__call" href="tel:{{ phone_digits }}">{{ section.settings.call_label | escape }}</a>
        {%- endif -%}
      </aside>

      <div class="cmc__ticket">
        <div class="cmc__stub">
          {%- if section.settings.ticket_heading != blank -%}
            <strong>{{ section.settings.ticket_heading | escape }}</strong>
          {%- endif -%}
          {%- if section.settings.ticket_note != blank -%}
            <small>{{ section.settings.ticket_note | escape }}</small>
          {%- endif -%}
        </div>

        {%- form 'contact', id: form_id -%}
          {%- if form.posted_successfully? -%}
            <p class="cmc__msg cmc__msg--ok" role="status" tabindex="-1" autofocus>
              {{ section.settings.success_message | escape }}
            </p>
          {%- elsif form.errors -%}
            <div class="cmc__msg cmc__msg--err" role="alert" tabindex="-1" autofocus>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="cmc__row">
            <div class="cmc__field">
              <input
                id="{{ form_id }}-name"
                name="contact[name]"
                type="text"
                autocomplete="name"
                placeholder=" "
                value="{% if form.name %}{{ form.name | escape }}{% endif %}"
              >
              <label for="{{ form_id }}-name">{{ section.settings.label_name | escape }}</label>
            </div>
            <div class="cmc__field">
              <input
                id="{{ form_id }}-email"
                name="contact[email]"
                type="email"
                autocomplete="email"
                autocapitalize="off"
                autocorrect="off"
                placeholder=" "
                required
                aria-required="true"
                value="{% if form.email %}{{ form.email | escape }}{% endif %}"
              >
              <label for="{{ form_id }}-email">{{ section.settings.label_email | escape }}</label>
            </div>
          </div>

          <div class="cmc__field">
            <input
              id="{{ form_id }}-phone"
              name="contact[phone]"
              type="tel"
              autocomplete="tel"
              placeholder=" "
              value="{% if form.phone %}{{ form.phone | escape }}{% endif %}"
            >
            <label for="{{ form_id }}-phone">{{ section.settings.label_phone | escape }}</label>
          </div>

          <div class="cmc__field cmc__field--grow">
            <textarea
              id="{{ form_id }}-body"
              name="contact[body]"
              rows="5"
              placeholder=" "
            >{% if form.body %}{{ form.body | escape }}{% endif %}</textarea>
            <label for="{{ form_id }}-body">{{ section.settings.label_comment | escape }}</label>
          </div>

          <div class="cmc__foot">
            <button type="submit" class="cmc__send">{{ section.settings.button_label | escape }}</button>
            {%- if section.settings.privacy_note != blank -%}
              <span class="cmc__note">{{ section.settings.privacy_note | escape }}</span>
            {%- endif -%}
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CM contact page",
  "tag": "section",
  "class": "section cm-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions or comments? Tell us what you're craving."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Lead text",
      "default": "Ask about meal plans, custom orders or delivery. A real person from the kitchen will get back to you."
    },
    {
      "type": "header",
      "content": "Stamp badge"
    },
    {
      "type": "checkbox",
      "id": "show_stamp",
      "label": "Show stamp badge",
      "default": true
    },
    {
      "type": "text",
      "id": "stamp_number",
      "label": "Stamp number",
      "default": "40+"
    },
    {
      "type": "textarea",
      "id": "stamp_label",
      "label": "Stamp label",
      "default": "years of\nculinary\nmastery"
    },
    {
      "type": "header",
      "content": "Kitchen panel"
    },
    {
      "type": "text",
      "id": "panel_heading",
      "label": "Panel heading",
      "default": "Reach the kitchen"
    },
    {
      "type": "textarea",
      "id": "panel_note",
      "label": "Panel note",
      "default": "Planning a custom meal plan or a private chef night? Add your dates and headcount in the message and we'll send a quote within a day."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Call button phone",
      "default": "+1 (920) 355-1137"
    },
    {
      "type": "text",
      "id": "call_label",
      "label": "Call button label",
      "default": "Talk to the kitchen"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true,
      "info": "Uses Facebook and Instagram links from Theme settings → Social media."
    },
    {
      "type": "header",
      "content": "Message ticket"
    },
    {
      "type": "text",
      "id": "ticket_heading",
      "label": "Ticket heading",
      "default": "Your message"
    },
    {
      "type": "text",
      "id": "ticket_note",
      "label": "Ticket note",
      "default": "We reply within one business day"
    },
    {
      "type": "text",
      "id": "label_name",
      "label": "Name label",
      "default": "Name"
    },
    {
      "type": "text",
      "id": "label_email",
      "label": "Email label",
      "default": "Email *"
    },
    {
      "type": "text",
      "id": "label_phone",
      "label": "Phone label",
      "default": "Phone number"
    },
    {
      "type": "text",
      "id": "label_comment",
      "label": "Comment label",
      "default": "Comment"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit button",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "privacy_note",
      "label": "Privacy note",
      "default": "We never share your details."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for reaching out! We'll get back to you as soon as possible."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#f5a623"
    },
    {
      "type": "color",
      "id": "navy",
      "label": "Panel navy",
      "default": "#0b1b36"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "contact_item",
      "name": "Contact detail",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "phone", "label": "Phone" },
            { "value": "pin", "label": "Location" },
            { "value": "clock", "label": "Clock" },
            { "value": "mail", "label": "Email" }
          ],
          "default": "phone"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Call us"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "+1 (920) 355-1137"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. Phone items auto-link with tel: when left empty."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CM contact page",
      "blocks": [
        {
          "type": "contact_item",
          "settings": {
            "icon": "phone",
            "label": "Call us",
            "value": "+1 (920) 355-1137"
          }
        },
        {
          "type": "contact_item",
          "settings": {
            "icon": "pin",
            "label": "Delivery area",
            "value": "We deliver across Milwaukee"
          }
        },
        {
          "type": "contact_item",
          "settings": {
            "icon": "clock",
            "label": "Order deadline",
            "value": "Order by Thursday for next week's delivery"
          }
        }
      ]
    }
  ]
}
{% endschema %}
