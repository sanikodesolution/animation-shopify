    "schedule": {
      "type": "cm-steps",
      "settings": {
        "label": "Weekly Schedule",
        "heading": "Order by Friday.\nEat Fresh on Monday.",
        "background": "white",
        "padding_top": 64,
        "padding_bottom": 64
      },
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "title": "Order by Friday",
            "text": "Place your order before the Friday 11:59 PM cutoff."
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "title": "Weekend Prep",
            "text": "Chef Matt shops and cooks every meal fresh from scratch."
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "title": "Monday Delivery",
            "text": "Meals arrive at your door between 10:00 AM and 2:00 PM."
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "title": "Heat and Eat",
            "text": "Keep them in the fridge and heat in 2-3 minutes."
          }
        }
      },
      "block_order": [
        "step_1",
        "step_2",
        "step_3",
        "step_4"
      ]
    },
    "delivery_faq": {
      "type": "collapsible-content",
      "settings": {
        "heading": "Delivery Questions",
        "heading_size": "h2",
        "heading_alignment": "center",
        "layout": "none",
        "container_color_scheme": "scheme-2",
        "color_scheme": "scheme-1",
        "open_first_collapsible_row": true,
        "image_ratio": "adapt",
        "desktop_layout": "image_second",
        "padding_top": 36,
        "padding_bottom": 36,
        "caption": ""
      },
      "blocks": {
        "collapsible_row_1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Which areas do you deliver to?",
            "icon": "check_mark",
            "row_content": "<p>We currently serve <strong>Hartland, Delafield, Pewaukee, Waukesha, Sussex, Merton, Nashotah, Okauchee Lake, Oconomowoc, Oconomowoc Lake, Chenequa, Lisbon, Lannon, Menomonee Falls, Brookfield, Elm Grove, Wales, Dousman, Summit, Lake Country, Stone Bank, North Lake, Mapleton, Genesee and Mukwonago.</strong></p>"
          }
        },
        "collapsible_row_2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "When will my meals arrive?",
            "icon": "check_mark",
            "row_content": "<p>Meals are delivered every <strong>Monday</strong> between <strong>10:00 AM – 2:00 PM</strong>. Orders must be placed before the weekly <strong>Friday 11:59 PM cutoff</strong>. A delivery logistics fee may apply depending on your location.</p>"
          }
        },
        "collapsible_row_3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is there a delivery fee?",
            "icon": "check_mark",
            "row_content": "<p>A delivery logistics fee may apply depending on your location. You will see it at checkout.</p>"
          }
        },
        "collapsible_row_4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long do meals stay fresh?",
            "icon": "check_mark",
            "row_content": "<p>Meals stay fresh in the fridge for up to several days. If needed, you can freeze them for longer storage. For best results, thaw completely and reheat thoroughly before eating.</p>"
          }
        }
      },
      "block_order": [
        "collapsible_row_1",
        "collapsible_row_2",
        "collapsible_row_3",
        "collapsible_row_4"
      ]
